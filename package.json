{
  "name": "trama-design-system",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Trama: design system multimarca para Hilo y Ruta",
  "scripts": {
    "tokens": "node scripts/build-tokens.mjs",
    "storybook": "npm run tokens && storybook dev -p 6006",
    "build-storybook": "npm run tokens && storybook build -o storybook-static",
    "typecheck": "tsc --noEmit && tsc --noEmit -p apps/hilo && tsc --noEmit -p apps/ruta",
    "dev-hilo": "vite --config apps/hilo/vite.config.ts",
    "build-hilo": "vite build --config apps/hilo/vite.config.ts",
    "dev-ruta": "vite --config apps/ruta/vite.config.ts",
    "build-ruta": "vite build --config apps/ruta/vite.config.ts"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@storybook/addon-a11y": "^8.6.14",
    "@storybook/addon-essentials": "^8.6.14",
    "@storybook/blocks": "^8.6.14",
    "@storybook/react": "^8.6.14",
    "@storybook/react-vite": "^8.6.14",
    "@storybook/test": "^8.6.14",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "lucide-react": "^0.460.0",
    "storybook": "^8.6.14",
    "storybook-addon-pseudo-states": "^4.0.4",
    "style-dictionary": "^4.4.0",
    "typescript": "^5.6.3",
    "vite": "^5.4.11"
  }
}
